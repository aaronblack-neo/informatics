  /*RaDaR® Post-Launch Ordering Analysis
  compared against - https://neogenomics.lightning.force.com/lightning/r/Report/00OVs00000IogPtMAJ/view?queryScope=userFolders
  ======================================
  Analyzes RaDaR test ordering patterns since the 2026 product launch.
  Tracks order status for each RaDaR MRD test variant (initial, follow-up, hold),
  identifies cross-sell opportunities by surfacing non-RaDaR tests ordered by the
  same patient, and includes tumor/treatment context from clinical intake data.

  REFACTORED V2: Primary driver is now GOLD V_GOLD_PANEL_TEST_DETAIL using
  MASTER_TEST_ORDERNAME ILIKE '%radar%'. This eliminates the raw WORKLISTTABLE
  as the driving set. WORKLISTTABLE is retained ONLY for:
    - Per-variant workflow step and date (not available in Gold)
    - PanTracer panel detection (PanTracer panels not in Gold test detail)
  
  Known gap: ~1-3 accessions that are same-day or have pre-2026 creation dates
  may not appear until Gold propagation completes (typically <24-48 hours).

  Tables Used:
    - DW_ENTERPRISE_PRD.GOLD.V_GOLD_PANEL_TEST_DETAIL      : PRIMARY DRIVER - RaDaR test identification, status, additional tests
    - DW_ENTERPRISE_PRD.GOLD.V_GOLD_ACCESSION               : Accession header (created datetime, client link, order type, disease stage, bill type)
    - DW_ENTERPRISE_PRD.GOLD.V_GOLD_CLIENT                   : Client/account master (name, number, type for exclusion)
    - DW_ENTERPRISE_PRD.GOLD.V_GOLD_PANEL                    : Panel-level detail (co-ordered panels like NEO PanTracer)
    - DW_ENTERPRISE_PRD.GOLD.V_GOLD_ORDERING_PROVIDER_PIVOT  : Ordering provider name and NPI
    - DW_ENTERPRISE_PRD.GOLD.V_GOLD_SALESREPMAPPING          : Client city/state/zip
    - DL_RAW_APVX_PRD.WORKFLOW.WORKLISTTABLE                 : Workflow step + date per variant, PanTracer detection
    - DL_RAW_APVX_PRD.ORDERS.ACCESSION                       : Patient ID bridge for PanTracer cross-patient lookup
    - DL_PRP_PRD.REF.V_EDW_APVX_RADAR_CLINICAL_INFORMATION   : RaDaR clinical intake (tumor type, treatment)
    - DL_RAW_APVX_PRD.ORDERS.RADARCLINICALINFO               : Resection date
    - DL_RAW_APVX_PRD.ORDERS.CLIENTSHIPPINGADDRESS            : Client facility address (city, state, zip)
    - DL_RAW_APVX_PRD.ORDERS.CLIENT                           : Client master for enhanced exclusion
    - DL_RAW_APVX_PRD.ORDERS.CLIENTTYPE                       : Client type lookup for exclusion

  Output:
    - DW_CUR_INFDLC_DEV.DW.T_RADAR_ST_POST_LAUNCH : One row per accession with RaDaR order status,
      cross-sell flags, clinical context, billing type, per-variant workflow step + date,
      disease stage, resection date, APVX accession ID, order type, ordering provider,
      co-ordered panels, client location, APVX patient ID,
      PanTracer panel co-order flag and panel names.
*/

--select * FROM DW_CUR_INFDLC_DEV.DW.T_RADAR_ST_POST_LAUNCH;

TRUNCATE TABLE DW_CUR_INFDLC_DEV.DW.T_RADAR_ST_POST_LAUNCH;

INSERT INTO DW_CUR_INFDLC_DEV.DW.T_RADAR_ST_POST_LAUNCH

-- ============================================================
-- CTE 0: excluded_clients
-- Dynamically identifies test, sample, proficiency, and other
-- non-production clients using BOTH the APVX CLIENTTYPE dimension
-- AND name-pattern matching. Catches ~15 more clients than
-- type-only filtering via V_GOLD_CLIENT.CLIENT_TYPE_NAME.
-- ============================================================
WITH excluded_clients AS (
    SELECT DISTINCT c.CLIENTID
    FROM DL_RAW_APVX_PRD.ORDERS.CLIENT c
    JOIN DL_RAW_APVX_PRD.ORDERS.CLIENTTYPE ct ON c.CLIENTTYPEID = ct.CLIENTTYPEID
    WHERE ct.CLIENTTYPENAME IN ('Sample', 'Proficiency Test')
       OR UPPER(c.CLIENTNAME) LIKE '%TEST%'
       OR UPPER(c.CLIENTNAME) LIKE '%SAMPLE%'
       OR UPPER(c.CLIENTNAME) LIKE '%QC %'
       OR UPPER(c.CLIENTNAME) LIKE '%QUALITY CONTROL%'
       OR UPPER(c.CLIENTNAME) LIKE '%PROFICIENCY%'
       OR UPPER(c.CLIENTNAME) LIKE '%DEMO%'
       OR UPPER(c.CLIENTNAME) LIKE '%VALIDATION%'
       OR UPPER(c.CLIENTNAME) LIKE '%DUMMY%'
       OR UPPER(c.CLIENTNAME) = 'UNKNOWN'
),

-- ============================================================
-- CTE 0b: excluded_master_clients
-- Maps APVX CLIENTID exclusions to GOLD MASTER_CLIENT_HUB_ID
-- for filtering at the Gold accession level.
-- Also includes Gold-native type exclusion as fallback.
-- ============================================================
excluded_master_clients AS (
    SELECT DISTINCT acc.MASTER_CLIENT_HUB_ID
    FROM DW_ENTERPRISE_PRD.GOLD.V_GOLD_ACCESSION acc
    JOIN DW_ENTERPRISE_PRD.DW.T_E_ACCESSION_HUB hub ON hub.ID = acc.ACCESSION_HUB_ID
    JOIN DL_RAW_APVX_PRD.ORDERS.ACCESSION apvx ON apvx.ACCESSIONID = SPLIT_PART(hub.ACCESSION_SOURCE_ID, '|', 4)::NUMBER
    WHERE apvx.CLIENTID IN (SELECT CLIENTID FROM excluded_clients)
    UNION
    SELECT MASTER_CLIENT_HUB_ID
    FROM DW_ENTERPRISE_PRD.GOLD.V_GOLD_CLIENT
    WHERE CLIENT_TYPE_NAME IN ('Proficiency Test', 'Sample')
),

-- ============================================================
-- CTE 1: radar_gold_base
-- PRIMARY DRIVER: Identifies all RaDaR accessions from Gold
-- V_GOLD_PANEL_TEST_DETAIL using MASTER_TEST_ORDERNAME.
-- Pivots RaDaR variant statuses and aggregates non-RaDaR tests
-- per accession in a single pass.
-- ============================================================
radar_gold_base AS (
    SELECT
        ptd.ACCESSION_HUB_ID,
        ptd.ACCESSIONID,
        MAX(CASE WHEN ptd.MASTER_TEST_ORDERNAME = 'RaDaR® ST First Timepoint'
            THEN ptd.SOURCE_TESTORDERSTATUS END) AS RADAR_STATUS_FIRST_TIMEPOINT,
        MAX(CASE WHEN ptd.MASTER_TEST_ORDERNAME = 'RaDaR® ST First Timepoint (Blood)'
            THEN ptd.SOURCE_TESTORDERSTATUS END) AS RADAR_STATUS_FIRST_TIMEPOINT_BLOOD,
        MAX(CASE WHEN ptd.MASTER_TEST_ORDERNAME = 'RaDaR® ST Follow-up Timepoint'
            THEN ptd.SOURCE_TESTORDERSTATUS END) AS RADAR_STATUS_FOLLOWUP_TIMEPOINT,
        MAX(CASE WHEN ptd.MASTER_TEST_ORDERNAME = 'RaDaR® Process and Hold'
            THEN ptd.SOURCE_TESTORDERSTATUS END) AS RADAR_STATUS_PROCESS_AND_HOLD,
        CASE WHEN MAX(CASE WHEN ptd.MASTER_TEST_ORDERNAME IN (
                'RaDaR® ST First Timepoint', 'RaDaR® ST First Timepoint (Blood)')
            THEN 1 END) = 1 THEN 1 ELSE 0 END AS IS_FIRST_TIMEPOINT,
        LISTAGG(DISTINCT CASE WHEN ptd.MASTER_TEST_ORDERNAME NOT ILIKE '%Radar%'
                AND ptd.MASTER_TEST_ORDERNAME IS NOT NULL
            THEN ptd.MASTER_TEST_ORDERNAME END, '; ')
            WITHIN GROUP (ORDER BY CASE WHEN ptd.MASTER_TEST_ORDERNAME NOT ILIKE '%Radar%'
                AND ptd.MASTER_TEST_ORDERNAME IS NOT NULL
            THEN ptd.MASTER_TEST_ORDERNAME END) AS ADDITIONAL_TESTS_SAME_ACCESSION,
        LISTAGG(DISTINCT ptd.CASENO, ', ') WITHIN GROUP (ORDER BY ptd.CASENO) AS CASE_NUMBERS
    FROM DW_ENTERPRISE_PRD.GOLD.V_GOLD_PANEL_TEST_DETAIL ptd
    JOIN DW_ENTERPRISE_PRD.GOLD.V_GOLD_ACCESSION acc
        ON acc.ACCESSION_HUB_ID = ptd.ACCESSION_HUB_ID
    WHERE acc.MASTER_CLIENT_HUB_ID NOT IN (SELECT MASTER_CLIENT_HUB_ID FROM excluded_master_clients)
      AND acc."ACCESSION CREATED DATETIME" >= '2026-01-01'
      AND EXISTS (
          SELECT 1 FROM DW_ENTERPRISE_PRD.GOLD.V_GOLD_PANEL_TEST_DETAIL ptd_r
          WHERE ptd_r.ACCESSION_HUB_ID = ptd.ACCESSION_HUB_ID
            AND ptd_r.MASTER_TEST_ORDERNAME ILIKE '%radar%'
      )
    GROUP BY ptd.ACCESSION_HUB_ID, ptd.ACCESSIONID
),

-- ============================================================
-- CTE 2: radar_accessions
-- Enriches the Gold-driven radar base with accession-level
-- metadata from V_GOLD_ACCESSION.
-- ============================================================
radar_accessions AS (
    SELECT
        rgb.ACCESSION_HUB_ID,
        rgb.ACCESSIONID,
        acc."ACCESSION CREATED DATETIME"::DATE AS ORDER_DATE,
        acc."ACCESSION ORDER TYPE" AS ACCESSION_ORDER_TYPE,
        acc.MASTER_CLIENT_HUB_ID,
        acc.DISEASE_STAGE,
        acc.ORDER_BILL_TO_INSTRUCTION AS BILL_TYPE,
        acc.E_PATIENT_HUB_ID,
        acc.PATIENT_SOURCE_ID,
        SPLIT_PART(acc.PATIENT_SOURCE_ID, '|', 4)::NUMBER AS APVX_PATIENT_ID,
        rgb.RADAR_STATUS_FIRST_TIMEPOINT,
        rgb.RADAR_STATUS_FIRST_TIMEPOINT_BLOOD,
        rgb.RADAR_STATUS_FOLLOWUP_TIMEPOINT,
        rgb.RADAR_STATUS_PROCESS_AND_HOLD,
        rgb.IS_FIRST_TIMEPOINT,
        rgb.ADDITIONAL_TESTS_SAME_ACCESSION,
        rgb.CASE_NUMBERS
    FROM radar_gold_base rgb
    JOIN DW_ENTERPRISE_PRD.GOLD.V_GOLD_ACCESSION acc
        ON acc.ACCESSION_HUB_ID = rgb.ACCESSION_HUB_ID
),

-- ============================================================
-- CTE 3: radar_workflow_by_variant
-- Classifies each RaDaR worklist row into one of 4 test variants
-- based on PANELS_TEXT. Retained for workflow step + date only
-- (not available in Gold layer).
-- ============================================================
radar_workflow_by_variant AS (
    SELECT
        ACCESSIONID,
        CASE
            WHEN PANELS_TEXT ILIKE '%(Blood) RaDaR%'       THEN 'First Timepoint (Blood)'
            WHEN PANELS_TEXT ILIKE '%First Timepoint%'     THEN 'First Timepoint'
            WHEN PANELS_TEXT ILIKE '%Follow-up%'           THEN 'Follow-up Timepoint'
            WHEN PANELS_TEXT ILIKE '%Process and Hold%'    THEN 'Process and Hold'
        END AS RADAR_VARIANT,
        WORKFLOWSTEP,
        LASTUPDATED,
        ROW_NUMBER() OVER (
            PARTITION BY ACCESSIONID,
                CASE
                    WHEN PANELS_TEXT ILIKE '%(Blood) RaDaR%'       THEN 'First Timepoint (Blood)'
                    WHEN PANELS_TEXT ILIKE '%First Timepoint%'     THEN 'First Timepoint'
                    WHEN PANELS_TEXT ILIKE '%Follow-up%'           THEN 'Follow-up Timepoint'
                    WHEN PANELS_TEXT ILIKE '%Process and Hold%'    THEN 'Process and Hold'
                END
            ORDER BY LASTUPDATED DESC
        ) AS rn
    FROM DL_RAW_APVX_PRD.WORKFLOW.WORKLISTTABLE
    WHERE PANELS_TEXT ILIKE '%Radar%'
),

-- ============================================================
-- CTE 4: latest_radar_workflow
-- Most recent workflow step and date per (accession, variant).
-- ============================================================
latest_radar_workflow AS (
    SELECT ACCESSIONID, RADAR_VARIANT, WORKFLOWSTEP, LASTUPDATED
    FROM radar_workflow_by_variant
    WHERE rn = 1
),

-- ============================================================
-- CTE 5: client_info
-- Client name, number, and shipping address from Gold + APVX.
-- ============================================================
client_info AS (
    SELECT
        gc.MASTER_CLIENT_HUB_ID,
        gc.CLIENT_NAME,
        gc.CLIENT_NUMBER,
        srm."CLIENT CITY"   AS CLIENT_CITY,
        srm."CLIENT STATE"  AS CLIENT_STATE,
        srm."CLIENT ZIP"    AS CLIENT_ZIP
    FROM DW_ENTERPRISE_PRD.GOLD.V_GOLD_CLIENT gc
    LEFT JOIN DW_ENTERPRISE_PRD.GOLD.V_GOLD_SALESREPMAPPING srm
        ON srm."CLIENT NO" = gc.CLIENT_NUMBER
    QUALIFY ROW_NUMBER() OVER (PARTITION BY gc.MASTER_CLIENT_HUB_ID ORDER BY gc.CLIENT_NUMBER) = 1
),

-- ============================================================
-- CTE 6: ordering_provider
-- Ordering provider name and NPI from Gold (deduplicated).
-- ============================================================
ordering_provider AS (
    SELECT
        E_ACCESSION AS ACCESSION_HUB_ID,
        MAX(ORDERING_PRACTITIONER_FULL_NAME) AS ORDERING_PROVIDER_NAME,
        MAX(ORDERING_PRACTITIONER_NPI)       AS ORDERING_PROVIDER_NPI
    FROM DW_ENTERPRISE_PRD.GOLD.V_GOLD_ORDERING_PROVIDER_PIVOT
    GROUP BY E_ACCESSION
),

-- ============================================================
-- CTE 7: accession_panels
-- Non-RaDaR panel names on the same accession from V_GOLD_PANEL.
-- ============================================================
accession_panels AS (
    SELECT
        p.ACCESSION_HUB_ID,
        LISTAGG(DISTINCT p."MASTER PANEL ORDER NAME", '; ')
            WITHIN GROUP (ORDER BY p."MASTER PANEL ORDER NAME") AS ADDITIONAL_PANELS_SAME_ACCESSION
    FROM DW_ENTERPRISE_PRD.GOLD.V_GOLD_PANEL p
    WHERE p."MASTER PANEL ORDER NAME" IS NOT NULL
      AND p."MASTER PANEL ORDER NAME" != ''
      AND p."MASTER PANEL ORDER NAME" NOT ILIKE '%Radar%'
    GROUP BY p.ACCESSION_HUB_ID
),

-- ============================================================
-- CTE 8: cross_accession_tests
-- Non-RaDaR tests on DIFFERENT accessions for the same patient.
-- ============================================================
cross_accession_tests AS (
    SELECT
        ra.E_PATIENT_HUB_ID,
        ra.ACCESSION_HUB_ID AS RADAR_ACCESSION_HUB_ID,
        LISTAGG(DISTINCT ptd.MASTER_TEST_ORDERNAME, '; ')
            WITHIN GROUP (ORDER BY ptd.MASTER_TEST_ORDERNAME) AS TESTS_DIFF_ACCESSION
    FROM radar_accessions ra
    JOIN DW_ENTERPRISE_PRD.GOLD.V_GOLD_ACCESSION ga2
        ON ga2.E_PATIENT_HUB_ID = ra.E_PATIENT_HUB_ID
        AND ga2.ACCESSION_HUB_ID != ra.ACCESSION_HUB_ID
        AND ga2."ACCESSION CREATED DATETIME" >= '2026-01-01'
    JOIN DW_ENTERPRISE_PRD.GOLD.V_GOLD_PANEL_TEST_DETAIL ptd
        ON ptd.ACCESSION_HUB_ID = ga2.ACCESSION_HUB_ID
        AND ptd.MASTER_TEST_ORDERNAME IS NOT NULL
        AND ptd.MASTER_TEST_ORDERNAME NOT ILIKE '%Radar%'
    GROUP BY ra.E_PATIENT_HUB_ID, ra.ACCESSION_HUB_ID
),

-- ============================================================
-- CTE 9: cross_accession_panels
-- Non-RaDaR panels on DIFFERENT accessions for the same patient.
-- ============================================================
cross_accession_panels AS (
    SELECT
        ra.E_PATIENT_HUB_ID,
        ra.ACCESSION_HUB_ID AS RADAR_ACCESSION_HUB_ID,
        LISTAGG(DISTINCT p."MASTER PANEL ORDER NAME", '; ')
            WITHIN GROUP (ORDER BY p."MASTER PANEL ORDER NAME") AS PANELS_DIFF_ACCESSION
    FROM radar_accessions ra
    JOIN DW_ENTERPRISE_PRD.GOLD.V_GOLD_ACCESSION ga2
        ON ga2.E_PATIENT_HUB_ID = ra.E_PATIENT_HUB_ID
        AND ga2.ACCESSION_HUB_ID != ra.ACCESSION_HUB_ID
        AND ga2."ACCESSION CREATED DATETIME" >= '2026-01-01'
    JOIN DW_ENTERPRISE_PRD.GOLD.V_GOLD_PANEL p
        ON p.ACCESSION_HUB_ID = ga2.ACCESSION_HUB_ID
        AND p."MASTER PANEL ORDER NAME" IS NOT NULL
        AND p."MASTER PANEL ORDER NAME" != ''
        AND p."MASTER PANEL ORDER NAME" NOT ILIKE '%Radar%'
    GROUP BY ra.E_PATIENT_HUB_ID, ra.ACCESSION_HUB_ID
),

-- ============================================================
-- CTE 10: patient_all_tests_cross
-- All non-RaDaR tests across ALL accessions for same patient
-- (includes same + different accessions). Broader cross-sell view.
-- ============================================================
patient_all_tests_cross AS (
    SELECT
        ra.E_PATIENT_HUB_ID,
        ra.ACCESSION_HUB_ID AS RADAR_ACCESSION_HUB_ID,
        LISTAGG(DISTINCT ptd.MASTER_TEST_ORDERNAME, '; ')
            WITHIN GROUP (ORDER BY ptd.MASTER_TEST_ORDERNAME) AS ALL_OTHER_TESTS
    FROM radar_accessions ra
    JOIN DW_ENTERPRISE_PRD.GOLD.V_GOLD_ACCESSION ga2
        ON ga2.E_PATIENT_HUB_ID = ra.E_PATIENT_HUB_ID
        AND ga2."ACCESSION CREATED DATETIME" >= '2026-01-01'
    JOIN DW_ENTERPRISE_PRD.GOLD.V_GOLD_PANEL_TEST_DETAIL ptd
        ON ptd.ACCESSION_HUB_ID = ga2.ACCESSION_HUB_ID
        AND ptd.MASTER_TEST_ORDERNAME IS NOT NULL
        AND ptd.MASTER_TEST_ORDERNAME NOT ILIKE '%Radar%'
    GROUP BY ra.E_PATIENT_HUB_ID, ra.ACCESSION_HUB_ID
),

-- ============================================================
-- CTE 11: radar_clinical
-- RaDaR clinical intake data (tumor type, treatment, resection).
-- Still from raw/prep layers - no Gold equivalent exists.
-- ============================================================
radar_clinical AS (
    SELECT
        ci.ACCESSIONID,
        ci.TUMORTYPENAME           AS TUMOR_TYPE,
        ci.TUMORSUBTYPENAME        AS TUMOR_SUBTYPE,
        ci.OTHERTUMORTYPEVALUE     AS TUMOR_TYPE_OTHER,
        ci.TREATMENTNAME           AS TREATMENT_NAME,
        ci.TUMORTYPE_EXPRESSION    AS TUMOR_TYPE_EXPRESSION,
        ci.TREATMENT_TYPE_LIST,
        rc.RESECTIONDATE::DATE     AS RESECTION_DATE
    FROM DL_PRP_PRD.REF.V_EDW_APVX_RADAR_CLINICAL_INFORMATION ci
    LEFT JOIN DL_RAW_APVX_PRD.ORDERS.RADARCLINICALINFO rc
        ON ci.ACCESSIONID = rc.ACCESSIONID
),

-- ============================================================
-- CTE 12: patient_pantracer
-- PanTracer panel names for same patient in 2026.
-- Still from WORKLISTTABLE - PanTracer not in Gold test detail.
-- ============================================================
patient_pantracer AS (
    SELECT
        wl.PATIENTID,
        LISTAGG(DISTINCT
            CASE WHEN wl.PANELS_TEXT ILIKE '%PanTracer%'
                 THEN REGEXP_SUBSTR(wl.PANELS_TEXT, 'NEO PanTracer[^`]*')
            END, '; ')
            WITHIN GROUP (ORDER BY
            CASE WHEN wl.PANELS_TEXT ILIKE '%PanTracer%'
                 THEN REGEXP_SUBSTR(wl.PANELS_TEXT, 'NEO PanTracer[^`]*')
            END) AS PANTRACER_PANEL_NAME
    FROM DL_RAW_APVX_PRD.WORKFLOW.WORKLISTTABLE wl
    WHERE wl.PANELS_TEXT ILIKE '%PanTracer%'
      AND wl.CREATEDDATE >= '2026-01-01'
      AND wl.CLIENTID NOT IN (SELECT CLIENTID FROM excluded_clients)
    GROUP BY wl.PATIENTID
),

-- ============================================================
-- CTE 13: client_shipping
-- Client facility address from APVX (fallback when Gold
-- SALESREPMAPPING doesn't have the address).
-- ============================================================
client_shipping AS (
    SELECT
        csa.CLIENTID,
        csa.CITY AS CLIENT_CITY,
        csa.STATEPROVINCE AS CLIENT_STATE,
        csa.POSTALCODE AS CLIENT_ZIP
    FROM DL_RAW_APVX_PRD.ORDERS.CLIENTSHIPPINGADDRESS csa
    WHERE csa."DEFAULT" = TRUE
      AND csa.ACTIVE = TRUE
    QUALIFY ROW_NUMBER() OVER (PARTITION BY csa.CLIENTID ORDER BY csa.CLIENTID) = 1
)

-- ============================================================
-- Main SELECT: one row per RaDaR accession from Gold
-- ============================================================
SELECT
    ra.ORDER_DATE,
    ci.CLIENT_NAME,

    -- RaDaR test variant statuses (directly from Gold SOURCE_TESTORDERSTATUS)
    ra.RADAR_STATUS_FIRST_TIMEPOINT,
    ra.RADAR_STATUS_FIRST_TIMEPOINT_BLOOD,
    ra.RADAR_STATUS_FOLLOWUP_TIMEPOINT,
    ra.RADAR_STATUS_PROCESS_AND_HOLD,

    -- Flag: 1 if accession includes a first timepoint order
    ra.IS_FIRST_TIMEPOINT,

    -- Non-RaDaR tests on the SAME accession
    ra.ADDITIONAL_TESTS_SAME_ACCESSION,

    -- Non-RaDaR tests across ALL accessions for the same patient
    patc.ALL_OTHER_TESTS AS ADDITIONAL_TESTS_CROSS_ACCESSION,

    -- Flag: 1 if patient has any non-RaDaR tests anywhere
    CASE WHEN patc.ALL_OTHER_TESTS IS NOT NULL AND patc.ALL_OTHER_TESTS != ''
        THEN 1 ELSE 0 END AS HAS_OTHER_TESTS,

    -- Clinical intake data
    rc.TUMOR_TYPE,
    rc.TUMOR_SUBTYPE,
    rc.TUMOR_TYPE_OTHER,
    rc.TREATMENT_NAME,
    rc.TUMOR_TYPE_EXPRESSION,
    rc.TREATMENT_TYPE_LIST,

    -- Accession identifiers
    ra.ACCESSION_HUB_ID,
    ra.CASE_NUMBERS,
    ci.CLIENT_NUMBER,

    -- Billing type (from Gold accession)
    ra.BILL_TYPE,

    -- Per-variant workflow step and date (from WORKLISTTABLE)
    MAX(CASE WHEN lrw.RADAR_VARIANT = 'First Timepoint'         THEN lrw.WORKFLOWSTEP END) AS WF_STEP_FIRST_TIMEPOINT,
    MAX(CASE WHEN lrw.RADAR_VARIANT = 'First Timepoint'         THEN lrw.LASTUPDATED END)::DATE AS WF_DATE_FIRST_TIMEPOINT,
    MAX(CASE WHEN lrw.RADAR_VARIANT = 'First Timepoint (Blood)' THEN lrw.WORKFLOWSTEP END) AS WF_STEP_FIRST_TIMEPOINT_BLOOD,
    MAX(CASE WHEN lrw.RADAR_VARIANT = 'First Timepoint (Blood)' THEN lrw.LASTUPDATED END)::DATE AS WF_DATE_FIRST_TIMEPOINT_BLOOD,
    MAX(CASE WHEN lrw.RADAR_VARIANT = 'Follow-up Timepoint'     THEN lrw.WORKFLOWSTEP END) AS WF_STEP_FOLLOWUP_TIMEPOINT,
    MAX(CASE WHEN lrw.RADAR_VARIANT = 'Follow-up Timepoint'     THEN lrw.LASTUPDATED END)::DATE AS WF_DATE_FOLLOWUP_TIMEPOINT,
    MAX(CASE WHEN lrw.RADAR_VARIANT = 'Process and Hold'        THEN lrw.WORKFLOWSTEP END) AS WF_STEP_PROCESS_AND_HOLD,
    MAX(CASE WHEN lrw.RADAR_VARIANT = 'Process and Hold'        THEN lrw.LASTUPDATED END)::DATE AS WF_DATE_PROCESS_AND_HOLD,

    -- Disease stage (from Gold accession)
    ra.DISEASE_STAGE,

    -- Resection date (from raw clinical intake)
    rc.RESECTION_DATE,

    -- APVX accession ID
    ra.ACCESSIONID::NUMBER AS APVX_ACCESSION_ID,

    -- Order entry method
    ra.ACCESSION_ORDER_TYPE,

    -- Ordering provider (from Gold)
    op.ORDERING_PROVIDER_NAME,

    -- Non-RaDaR panels on same accession
    ap.ADDITIONAL_PANELS_SAME_ACCESSION,

    -- Client location (Gold salesrep mapping preferred, APVX shipping fallback)
    COALESCE(ci.CLIENT_CITY, cs.CLIENT_CITY) AS CLIENT_CITY,
    COALESCE(ci.CLIENT_STATE, cs.CLIENT_STATE) AS CLIENT_STATE,
    COALESCE(ci.CLIENT_ZIP, cs.CLIENT_ZIP) AS CLIENT_ZIP,

    -- APVX patient ID
    ra.APVX_PATIENT_ID,

    -- PanTracer co-order (from WORKLISTTABLE)
    ppt.PANTRACER_PANEL_NAME,
    CASE WHEN ppt.PANTRACER_PANEL_NAME IS NOT NULL THEN 1 ELSE 0 END AS HAS_PANTRACER,

    -- Portfolio flags (derived from text columns to prevent false positives)
    CASE WHEN ap.ADDITIONAL_PANELS_SAME_ACCESSION IS NOT NULL THEN 1 ELSE 0 END AS HAS_PANELS_SAME_ACCESSION,
    CASE WHEN cat.TESTS_DIFF_ACCESSION IS NOT NULL AND cat.TESTS_DIFF_ACCESSION != '' THEN 1 ELSE 0 END AS HAS_TESTS_DIFF_ACCESSION,
    CASE WHEN cap.PANELS_DIFF_ACCESSION IS NOT NULL AND cap.PANELS_DIFF_ACCESSION != '' THEN 1 ELSE 0 END AS HAS_PANELS_DIFF_ACCESSION,
    CASE WHEN ra.ADDITIONAL_TESTS_SAME_ACCESSION IS NOT NULL AND ra.ADDITIONAL_TESTS_SAME_ACCESSION != '' THEN 1 ELSE 0 END AS HAS_TESTS_SAME_ACCESSION,

    -- Cross-accession detail
    cat.TESTS_DIFF_ACCESSION,
    cap.PANELS_DIFF_ACCESSION,

    -- Summary flag: 1 if ANY non-RaDaR test or panel ordered (same or different accession)
    CASE WHEN (ra.ADDITIONAL_TESTS_SAME_ACCESSION IS NOT NULL AND ra.ADDITIONAL_TESTS_SAME_ACCESSION != '')
              OR ap.ADDITIONAL_PANELS_SAME_ACCESSION IS NOT NULL
              OR (cat.TESTS_DIFF_ACCESSION IS NOT NULL AND cat.TESTS_DIFF_ACCESSION != '')
              OR (cap.PANELS_DIFF_ACCESSION IS NOT NULL AND cap.PANELS_DIFF_ACCESSION != '')
              OR ppt.PANTRACER_PANEL_NAME IS NOT NULL
         THEN 1 ELSE 0 END AS HAS_ANY_ADDITIONAL_ORDER,

    -- Ordering provider NPI (from Gold)
    op.ORDERING_PROVIDER_NPI

FROM radar_accessions ra

-- Client info (Gold)
LEFT JOIN client_info ci
    ON ci.MASTER_CLIENT_HUB_ID = ra.MASTER_CLIENT_HUB_ID

-- Per-variant workflow steps (WORKLISTTABLE - only remaining raw dependency for core fields)
LEFT JOIN latest_radar_workflow lrw
    ON lrw.ACCESSIONID = ra.ACCESSIONID::NUMBER

-- Ordering provider (Gold)
LEFT JOIN ordering_provider op
    ON op.ACCESSION_HUB_ID = ra.ACCESSION_HUB_ID

-- Non-RaDaR panels same accession (Gold)
LEFT JOIN accession_panels ap
    ON ap.ACCESSION_HUB_ID = ra.ACCESSION_HUB_ID

-- Cross-accession tests (Gold)
LEFT JOIN cross_accession_tests cat
    ON cat.RADAR_ACCESSION_HUB_ID = ra.ACCESSION_HUB_ID

-- Cross-accession panels (Gold)
LEFT JOIN cross_accession_panels cap
    ON cap.RADAR_ACCESSION_HUB_ID = ra.ACCESSION_HUB_ID

-- All patient tests cross-accession (Gold)
LEFT JOIN patient_all_tests_cross patc
    ON patc.RADAR_ACCESSION_HUB_ID = ra.ACCESSION_HUB_ID

-- Clinical intake (raw - no Gold equivalent)
LEFT JOIN radar_clinical rc
    ON rc.ACCESSIONID = ra.ACCESSIONID::NUMBER

-- Client shipping address (raw fallback)
LEFT JOIN DL_RAW_APVX_PRD.ORDERS.ACCESSION apvx_acc
    ON apvx_acc.ACCESSIONID = ra.ACCESSIONID::NUMBER
LEFT JOIN client_shipping cs
    ON cs.CLIENTID = apvx_acc.FACILITYID

-- PanTracer lookup (WORKLISTTABLE - PanTracer not in Gold)
LEFT JOIN patient_pantracer ppt
    ON ppt.PATIENTID = ra.APVX_PATIENT_ID

GROUP BY
    ra.ORDER_DATE, ci.CLIENT_NAME,
    ra.RADAR_STATUS_FIRST_TIMEPOINT, ra.RADAR_STATUS_FIRST_TIMEPOINT_BLOOD,
    ra.RADAR_STATUS_FOLLOWUP_TIMEPOINT, ra.RADAR_STATUS_PROCESS_AND_HOLD,
    ra.IS_FIRST_TIMEPOINT, ra.ADDITIONAL_TESTS_SAME_ACCESSION,
    patc.ALL_OTHER_TESTS,
    rc.TUMOR_TYPE, rc.TUMOR_SUBTYPE, rc.TUMOR_TYPE_OTHER,
    rc.TREATMENT_NAME, rc.TUMOR_TYPE_EXPRESSION, rc.TREATMENT_TYPE_LIST,
    ra.ACCESSION_HUB_ID, ra.CASE_NUMBERS, ci.CLIENT_NUMBER,
    ra.BILL_TYPE, ra.DISEASE_STAGE, rc.RESECTION_DATE,
    ra.ACCESSIONID, ra.ACCESSION_ORDER_TYPE,
    op.ORDERING_PROVIDER_NAME, ap.ADDITIONAL_PANELS_SAME_ACCESSION,
    ci.CLIENT_CITY, ci.CLIENT_STATE, ci.CLIENT_ZIP,
    cs.CLIENT_CITY, cs.CLIENT_STATE, cs.CLIENT_ZIP,
    ra.APVX_PATIENT_ID, ppt.PANTRACER_PANEL_NAME,
    cat.TESTS_DIFF_ACCESSION, cap.PANELS_DIFF_ACCESSION,
    op.ORDERING_PROVIDER_NPI,
    ra.E_PATIENT_HUB_ID;



