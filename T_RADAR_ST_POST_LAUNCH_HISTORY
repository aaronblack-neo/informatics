/*
  RaDaR® ST Post-Launch History Capture (Option C)
  =================================================
  Run this AFTER the TRUNCATE+INSERT into T_RADAR_ST_POST_LAUNCH completes.
  Appends a daily snapshot row per accession to the history table with change flags.
  Also captures DELETED accessions (present yesterday, absent today).

  CHANGED_COLUMNS values:
    - 'NEW'     : First appearance of this accession in the dataset
    - 'DELETED' : Accession was in yesterday's snapshot but not in today's (excluded or removed)
    - 'col1; col2' : Semicolon-delimited list of columns that changed vs prior day
    - '' (empty): No changes detected (status quo)

  Add this as the NEXT CELL in your existing scheduled notebook.
*/

INSERT INTO DW_CUR_INFDLC_DEV.DW.T_RADAR_ST_POST_LAUNCH_HISTORY
SELECT
    CURRENT_DATE AS SNAPSHOT_DATE,
    curr.ACCESSION_HUB_ID,
    curr.ORDER_DATE,
    curr.CLIENT_NAME,
    curr.CLIENT_NUMBER,
    curr.DETAILED_STATUS,
    curr.CURRENT_STATUS,
    curr.IS_FIRST_TIMEPOINT,
    curr.TEST_TYPE,
    curr.OVERALL_STATUS,
    curr.REPORTED_DATE,
    curr.FIRST_BLOOD_RECEIVED_DATE,
    curr.FIRST_TISSUE_RECEIVED_DATE,
    curr.TAT_DAYS,
    curr.DAYS_IN_LAB,
    curr.DAYS_TISSUE_TO_BLOOD,
    curr.HAS_QNS_TNP,
    curr.QNS_TNP_VARIANT AS QNS_TNP_OUTCOME,
    curr.INCIDENT_COUNT,
    curr.IS_REPORTED,
    curr.IS_TRUE_QNS_TNP,
    curr.IS_CANCELLED,
    curr.WF_STEP_FIRST_TIMEPOINT,
    curr.WF_STEP_FIRST_TIMEPOINT_BLOOD,
    curr.WF_STEP_FOLLOWUP_TIMEPOINT,
    curr.WF_STEP_PROCESS_AND_HOLD,
    curr.TISSUE_DATE_SOURCE,
    CASE WHEN prev.ACCESSION_HUB_ID IS NULL THEN 1 ELSE 0 END AS IS_NEW_ACCESSION,
    CASE WHEN prev.DETAILED_STATUS IS NULL OR prev.DETAILED_STATUS != curr.DETAILED_STATUS THEN 1 ELSE 0 END AS IS_STATUS_CHANGE,
    prev.DETAILED_STATUS AS PREV_DETAILED_STATUS,
    CASE
        WHEN prev.ACCESSION_HUB_ID IS NULL THEN 'NEW'
        ELSE ARRAY_TO_STRING(ARRAY_COMPACT(ARRAY_CONSTRUCT(
            CASE WHEN curr.DETAILED_STATUS != prev.DETAILED_STATUS THEN 'DETAILED_STATUS' END,
            CASE WHEN curr.CURRENT_STATUS != prev.CURRENT_STATUS THEN 'CURRENT_STATUS' END,
            CASE WHEN COALESCE(curr.REPORTED_DATE::VARCHAR,'') != COALESCE(prev.REPORTED_DATE::VARCHAR,'') THEN 'REPORTED_DATE' END,
            CASE WHEN COALESCE(curr.FIRST_BLOOD_RECEIVED_DATE::VARCHAR,'') != COALESCE(prev.FIRST_BLOOD_RECEIVED_DATE::VARCHAR,'') THEN 'FIRST_BLOOD_RECEIVED_DATE' END,
            CASE WHEN COALESCE(curr.FIRST_TISSUE_RECEIVED_DATE::VARCHAR,'') != COALESCE(prev.FIRST_TISSUE_RECEIVED_DATE::VARCHAR,'') THEN 'FIRST_TISSUE_RECEIVED_DATE' END,
            CASE WHEN COALESCE(curr.HAS_QNS_TNP,0) != COALESCE(prev.HAS_QNS_TNP,0) THEN 'HAS_QNS_TNP' END,
            CASE WHEN COALESCE(curr.IS_REPORTED,0) != COALESCE(prev.IS_REPORTED,0) THEN 'IS_REPORTED' END,
            CASE WHEN COALESCE(curr.IS_CANCELLED,0) != COALESCE(prev.IS_CANCELLED,0) THEN 'IS_CANCELLED' END,
            CASE WHEN COALESCE(curr.INCIDENT_COUNT,0) != COALESCE(prev.INCIDENT_COUNT,0) THEN 'INCIDENT_COUNT' END,
            CASE WHEN COALESCE(curr.WF_STEP_FIRST_TIMEPOINT,'') != COALESCE(prev.WF_STEP_FIRST_TIMEPOINT,'') THEN 'WF_STEP_FIRST_TIMEPOINT' END,
            CASE WHEN COALESCE(curr.WF_STEP_FOLLOWUP_TIMEPOINT,'') != COALESCE(prev.WF_STEP_FOLLOWUP_TIMEPOINT,'') THEN 'WF_STEP_FOLLOWUP_TIMEPOINT' END
        )), '; ')
    END AS CHANGED_COLUMNS,
    COALESCE(
        DATEDIFF('day', last_change.LAST_STATUS_CHANGE_DATE, CURRENT_DATE),
        DATEDIFF('day', curr.ORDER_DATE, CURRENT_DATE)
    ) AS DAYS_IN_CURRENT_STATUS
FROM DW_CUR_INFDLC_DEV.DW.T_RADAR_ST_POST_LAUNCH curr
LEFT JOIN DW_CUR_INFDLC_DEV.DW.T_RADAR_ST_POST_LAUNCH_HISTORY prev
    ON prev.ACCESSION_HUB_ID = curr.ACCESSION_HUB_ID
    AND prev.SNAPSHOT_DATE = CURRENT_DATE - 1
LEFT JOIN (
    SELECT ACCESSION_HUB_ID, MAX(SNAPSHOT_DATE) AS LAST_STATUS_CHANGE_DATE
    FROM DW_CUR_INFDLC_DEV.DW.T_RADAR_ST_POST_LAUNCH_HISTORY
    WHERE IS_STATUS_CHANGE = 1
    GROUP BY ACCESSION_HUB_ID
) last_change ON last_change.ACCESSION_HUB_ID = curr.ACCESSION_HUB_ID

UNION ALL

SELECT
    CURRENT_DATE AS SNAPSHOT_DATE,
    prev.ACCESSION_HUB_ID,
    prev.ORDER_DATE,
    prev.CLIENT_NAME,
    prev.CLIENT_NUMBER,
    'DELETED' AS DETAILED_STATUS,
    prev.CURRENT_STATUS,
    prev.IS_FIRST_TIMEPOINT,
    prev.TEST_TYPE,
    prev.OVERALL_STATUS,
    prev.REPORTED_DATE,
    prev.FIRST_BLOOD_RECEIVED_DATE,
    prev.FIRST_TISSUE_RECEIVED_DATE,
    prev.TAT_DAYS,
    prev.DAYS_IN_LAB,
    prev.DAYS_TISSUE_TO_BLOOD,
    prev.HAS_QNS_TNP,
    prev.QNS_TNP_OUTCOME,
    prev.INCIDENT_COUNT,
    prev.IS_REPORTED,
    prev.IS_TRUE_QNS_TNP,
    prev.IS_CANCELLED,
    prev.WF_STEP_FIRST_TIMEPOINT,
    prev.WF_STEP_FIRST_TIMEPOINT_BLOOD,
    prev.WF_STEP_FOLLOWUP_TIMEPOINT,
    prev.WF_STEP_PROCESS_AND_HOLD,
    prev.TISSUE_DATE_SOURCE,
    0 AS IS_NEW_ACCESSION,
    1 AS IS_STATUS_CHANGE,
    prev.DETAILED_STATUS AS PREV_DETAILED_STATUS,
    'DELETED' AS CHANGED_COLUMNS,
    DATEDIFF('day', prev.ORDER_DATE, CURRENT_DATE) AS DAYS_IN_CURRENT_STATUS
FROM DW_CUR_INFDLC_DEV.DW.T_RADAR_ST_POST_LAUNCH_HISTORY prev
LEFT JOIN DW_CUR_INFDLC_DEV.DW.T_RADAR_ST_POST_LAUNCH curr
    ON curr.ACCESSION_HUB_ID = prev.ACCESSION_HUB_ID
WHERE prev.SNAPSHOT_DATE = CURRENT_DATE - 1
  AND prev.CHANGED_COLUMNS != 'DELETED'
  AND curr.ACCESSION_HUB_ID IS NULL;
